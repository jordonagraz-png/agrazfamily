rules_version = '2';

// ============================================================================
//  Agraz Family — Firestore Security Rules
//
//  PUBLISH THESE in the Firebase console (Firestore Database → Rules → Publish)
//  or with the CLI:  firebase deploy --only firestore:rules
//  See README.md for the one-time setup (invite code, admins, approval).
//
//  These rules are the ONLY thing that keeps family data private. The website
//  is public code; nothing secret is in it.
//
//  Membership model
//  ----------------
//  • You are a family member if users/{your uid} exists and isn't waiting for
//    approval (approved != false).
//  • That doc can only be created after you've written joins/{your uid} with
//    the correct invite code, which is checked HERE against config/invite
//    (a doc only family admins can read — from the hub's Invite page).
//  • If config/invite has requireApproval: true, new members start with
//    approved: false and an admin approves them on the Invite page.
//  • Roles live on users/{uid}.role: "owner" (claimed once with the owner key,
//    can't be demoted or removed by anyone else) > "admin" (made by the owner)
//    > member. Admins manage members, invites and approvals and can remove any
//    post or comment.
//  • To remove someone: delete their users/{uid} doc (admins can do this from
//    the site too) and disable their account under Authentication → Users.
//  • Time capsule letters (capsuleLetters) can't be read by anyone before their
//    capsule's openAt time — the seal is enforced here, not by the website.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }

    function isMember() {
      return signedIn() && exists(myUserPath()) && get(myUserPath()).data.get('approved', true) == true;
    }

    // Roles: owner (one per family, can't be demoted by anyone) > admin > member.
    function myRole() { return get(myUserPath()).data.get('role', ''); }
    function isAdmin() { return isMember() && myRole() in ['admin', 'owner']; }
    function isOwner() { return isMember() && myRole() == 'owner'; }

    // SHA-256 of the one-time owner key (the key itself is never stored in this code).
    function ownerKeyHash() { return 'adeb865cf6c841622fccb13fbe6e1f3e816281586bacf453a5de0c0f3b4a4103'; }

    function approvalRequired() {
      return get(/databases/$(database)/documents/config/invite).data.get('requireApproval', false) == true;
    }

    // A base64 image data URL (what the site produces), under `max` characters.
    function isImage(s, max) {
      return s is string && s.size() < max
        && s.matches('data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/]+=*');
    }

    // Optional string field: absent, or a string no longer than `max`.
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function str(s, min, max) { return s is string && s.size() >= min && s.size() <= max; }

    // A member may only change their own entry in a per-person map field such as
    // hearts {uid: true} or rsvp {uid: "yes"} — nothing else on the document.
    function onlyMyEntry(field, allowed) {
      let before = resource.data.get(field, {});
      let after = request.resource.data.get(field, {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || after[request.auth.uid] in allowed);
    }

    // ---- Invite settings: the invite code + approval switch. ----
    // Only family admins can see or change them (from the hub's Invite page).
    match /config/{doc} {
      allow get: if doc == 'invite' && isAdmin();
      allow create, update: if doc == 'invite' && isAdmin()
                    && request.resource.data.keys().hasOnly(['code', 'requireApproval'])
                    && str(request.resource.data.code, 6, 64)
                    && request.resource.data.code.matches('[A-Za-z0-9-]+')
                    && request.resource.data.get('requireApproval', false) is bool;
      // One-time owner claim (README → "Owner"): whoever holds the owner key can make their
      // own account the owner, once. Must be in the same batch that sets their role.
      allow create: if doc == 'owner' && isMember()
                    && request.resource.data.keys().hasOnly(['uid', 'key', 'claimedAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.key is string
                    && hashing.sha256(request.resource.data.key.toUtf8()).toHexString().lower() == ownerKeyHash()
                    && getAfter(myUserPath()).data.get('role', '') == 'owner';
      allow list, delete: if false;
    }

    // ---- Join requests: proves you know the invite code. Write-once, unreadable. ----
    match /joins/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['code', 'createdAt'])
                    && request.resource.data.code is string
                    && request.resource.data.code == get(/databases/$(database)/documents/config/invite).data.code;
      // You may check your own join (to finish an interrupted sign-up); never anyone else's.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, update, delete: if false;
    }

    // ---- Member profiles (the family directory) ----
    match /users/{uid} {
      // Your spot on the Family Globe: rounded coordinates, a place name, your time zone.
      function validPlace(p) {
        return p is map && p.keys().hasOnly(['lat', 'lng', 'label', 'tz'])
          && p.lat is number && p.lat >= -90 && p.lat <= 90
          && p.lng is number && p.lng >= -180 && p.lng <= 180
          && str(p.label, 1, 60) && optStr(p, 'tz', 64);
      }
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'email', 'uid', 'joinedDate', 'phone', 'birthday', 'address', 'bio', 'avatar', 'approved', 'role', 'place', 'treeId'])
          && d.uid == uid
          && str(d.name, 1, 80)
          && optStr(d, 'email', 254) && optStr(d, 'joinedDate', 40)
          && optStr(d, 'phone', 40) && optStr(d, 'birthday', 10)
          && optStr(d, 'address', 300) && optStr(d, 'bio', 280)
          && (!('avatar' in d) || d.avatar == '' || isImage(d.avatar, 150000))
          && (!('approved' in d) || d.approved is bool)
          && (!('role' in d) || d.role in ['', 'admin', 'owner'])
          && (!('place' in d) || d.place == null || validPlace(d.place))
          && (!('treeId' in d) || d.treeId == null || (d.treeId is string && d.treeId.matches('[A-Za-z0-9_-]{1,40}')));
      }
      // Members see the whole family; anyone signed in may read their own doc
      // (that's how the site knows to ask for the code or show "waiting").
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
                    && exists(/databases/$(database)/documents/joins/$(uid))
                    && validProfile(request.resource.data)
                    && request.resource.data.email == request.auth.token.email
                    && !('role' in request.resource.data)
                    && request.resource.data.approved is bool
                    && (request.resource.data.approved == false || !approvalRequired());
      // Your own profile: anything except your email, approval or role.
      allow update: if signedIn() && request.auth.uid == uid
                    && validProfile(request.resource.data)
                    && request.resource.data.get('email', '') == resource.data.get('email', '')
                    && request.resource.data.get('approved', true) == resource.data.get('approved', true)
                    && request.resource.data.get('role', '') == resource.data.get('role', '');
      // The one-time owner claim (see config/owner above): your own role → owner.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                    && request.resource.data.role == 'owner'
                    && !exists(/databases/$(database)/documents/config/owner)
                    && getAfter(/databases/$(database)/documents/config/owner).data.uid == uid;
      // Admins look after other members (never the owner): approve, edit details.
      // Only the owner can make someone an admin or take it away.
      allow update: if isAdmin() && request.auth.uid != uid
                    && resource.data.get('role', '') != 'owner'
                    && validProfile(request.resource.data)
                    && request.resource.data.get('email', '') == resource.data.get('email', '')
                    && (request.resource.data.get('role', '') == resource.data.get('role', '')
                        || (isOwner() && request.resource.data.get('role', '') in ['', 'admin']));
      // Leave yourself; admins remove members; the owner can remove anyone but themselves.
      allow delete: if signedIn() && (request.auth.uid == uid
                    || (isAdmin() && resource.data.get('role', '') == '')
                    || (isOwner() && resource.data.get('role', '') != 'owner'));
    }

    // ---- Shared photo album (+ hearts) ----
    match /memories/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && isImage(request.resource.data.imageData, 950000)
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() < 2000
                    && !('hearts' in request.resource.data);
      allow update: if isMember() && onlyMyEntry('hearts', [true, false]);
      // Shared family album: any member may remove a photo. To limit this to the
      // uploader, use:  allow delete: if isMember() && resource.data.uid == request.auth.uid;
      allow delete: if isMember();
    }

    // ---- Family calendar (+ RSVPs) ----
    match /events/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.title, 1, 199)
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.description is string
                    && request.resource.data.description.size() < 5000
                    && optStr(request.resource.data, 'time', 5)
                    && optStr(request.resource.data, 'location', 200)
                    && !('rsvp' in request.resource.data);
      allow update: if isMember() && onlyMyEntry('rsvp', ['yes', 'maybe', 'no']);
      allow delete: if isMember();
    }

    // ---- Updates feed (+ hearts) ----
    match /updates/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.text, 1, 4999)
                    && !('hearts' in request.resource.data);
      allow update: if isMember() && onlyMyEntry('hearts', [true, false]);
      allow delete: if isMember();
    }

    // ---- Comments on updates and photos ----
    match /comments/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['parent', 'text', 'uid', 'author', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.text, 1, 2000)
                    && request.resource.data.parent is string
                    && request.resource.data.parent.matches('(updates|memories)/[A-Za-z0-9_-]{1,64}');
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---- Family Vault: shared notes (emergency contacts, doctors, household info) ----
    match /vault/{id} {
      function validNote(d) {
        return d.keys().hasOnly(['title', 'body', 'category', 'uid', 'author', 'createdAt', 'updatedAt', 'updatedBy'])
          && str(d.title, 1, 120)
          && d.body is string && d.body.size() <= 8000
          && d.category in ['emergency', 'medical', 'household', 'documents', 'other'];
      }
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && validNote(request.resource.data);
      allow update: if isMember()
                    && validNote(request.resource.data)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isMember();
    }

    // ---- Family Recipe Book ----
    match /recipes/{id} {
      function validRecipe(d) {
        return d.keys().hasOnly(['title', 'by', 'category', 'time', 'servings', 'ingredients', 'steps', 'photo', 'uid', 'author', 'createdAt', 'updatedAt', 'updatedBy'])
          && str(d.title, 1, 120)
          && optStr(d, 'by', 80) && optStr(d, 'time', 40) && optStr(d, 'servings', 40)
          && d.category in ['mains', 'sides', 'desserts', 'breakfast', 'drinks', 'other']
          && d.ingredients is string && d.ingredients.size() <= 6000
          && d.steps is string && d.steps.size() <= 12000
          && (!('photo' in d) || d.photo == '' || isImage(d.photo, 400000));
      }
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && validRecipe(request.resource.data);
      allow update: if isMember()
                    && validRecipe(request.resource.data)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isMember();
    }

    // ---- In Memory of Hector Agraz: private family photos ----
    match /memorial/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && isImage(request.resource.data.imageData, 950000)
                    && request.resource.data.order is number;
      allow delete: if isMember();
    }

    // ---- Memorial guestbook: memories shared about Hector ----
    match /tributes/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['text', 'uid', 'author', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.text, 1, 4000);
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---- Memorial candles: one per person ----
    match /candles/{uid} {
      allow read:   if isMember();
      allow create: if isMember() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'litAt'])
                    && str(request.resource.data.name, 1, 80);
      allow delete: if isMember() && (request.auth.uid == uid || isAdmin());
    }

    // ---- Time capsules: letters sealed until a chosen day ----
    // The seal is enforced HERE, by Google's servers: nobody — not even the person who
    // wrote it — can read a letter before its openAt time (milliseconds since 1970).
    // The capsule (who, for whom, when) is visible to the family; the letter isn't.
    match /capsules/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['title', 'to', 'uid', 'author', 'createdAt', 'openAt', 'hasPhoto'])
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.title, 1, 120)
                    && optStr(request.resource.data, 'to', 120)
                    && str(request.resource.data.author, 1, 80)
                    && request.resource.data.openAt is int
                    && request.resource.data.openAt > request.time.toMillis() + 3600000
                    && request.resource.data.openAt < request.time.toMillis() + 3155760000000
                    && request.resource.data.hasPhoto is bool
                    && existsAfter(/databases/$(database)/documents/capsuleLetters/$(id));
      // Once it's open, each person can mark that they've read it.
      allow update: if isMember()
                    && request.time.toMillis() >= resource.data.openAt
                    && onlyMyEntry('openedBy', [true]);
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /capsuleLetters/{id} {
      allow get:    if isMember()
                    && request.time.toMillis() >= get(/databases/$(database)/documents/capsules/$(id)).data.openAt;
      // Written only together with its brand-new capsule, so a sealed letter can never be swapped.
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['text', 'photo', 'uid'])
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.text, 1, 20000)
                    && (!('photo' in request.resource.data) || request.resource.data.photo == '' || isImage(request.resource.data.photo, 800000))
                    && !exists(/databases/$(database)/documents/capsules/$(id))
                    && getAfter(/databases/$(database)/documents/capsules/$(id)).data.uid == request.auth.uid;
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list, update: if false;
    }

    // ---- Voice stories: recordings of the family telling their stories (+ hearts) ----
    // The audio is split into up to 3 parts of ≤ 900 KB (storyAudio/{storyId}_{n}).
    match /stories/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['title', 'prompt', 'uid', 'author', 'createdAt', 'duration', 'mime', 'parts', 'peaks'])
                    && request.resource.data.uid == request.auth.uid
                    && str(request.resource.data.title, 1, 120)
                    && optStr(request.resource.data, 'prompt', 200)
                    && str(request.resource.data.author, 1, 80)
                    && request.resource.data.duration is number
                    && request.resource.data.duration > 0 && request.resource.data.duration <= 900
                    && str(request.resource.data.mime, 6, 60)
                    && request.resource.data.mime.matches('audio/[a-z0-9.+-]+(;[ ]?codecs=[A-Za-z0-9.,"+-]+)?')
                    && request.resource.data.parts is int
                    && request.resource.data.parts >= 1 && request.resource.data.parts <= 3
                    && optStr(request.resource.data, 'peaks', 400)
                    && existsAfter(/databases/$(database)/documents/storyAudio/$(id + '_0'));
      allow update: if isMember() && onlyMyEntry('hearts', [true, false]);
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /storyAudio/{part} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly(['story', 'n', 'data', 'uid'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.n is int
                    && request.resource.data.n >= 0 && request.resource.data.n <= 2
                    && request.resource.data.story is string
                    && part == request.resource.data.story + '_' + string(request.resource.data.n)
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() <= 900000
                    && !exists(/databases/$(database)/documents/stories/$(request.resource.data.story))
                    && getAfter(/databases/$(database)/documents/stories/$(request.resource.data.story)).data.uid == request.auth.uid;
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---- Family tree: imported from an Ancestry export by an admin (Family Tree page) ----
    // tree/meta describes it; tree/part0… hold the people and families. Living relatives
    // are stored with their birth year only (the hub trims them before saving).
    match /tree/{doc} {
      allow read: if isMember();
      allow create, update: if isAdmin() && (
        (doc == 'meta'
          && request.resource.data.keys().hasOnly(['v', 'name', 'treeId', 'source', 'people', 'families', 'portraits', 'earliest', 'generations', 'parts', 'importedAt', 'importedBy'])
          && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 20
          && request.resource.data.people is int && request.resource.data.families is int
          && optStr(request.resource.data, 'name', 80) && optStr(request.resource.data, 'importedBy', 80))
        || (doc.matches('part([0-9]|1[0-9])')
          && request.resource.data.keys().hasOnly(['people', 'families'])
          && request.resource.data.people is list && request.resource.data.families is list)
        // research notes gathered from public records (sources, documents, leads), kept apart
        // from the Ancestry data so updating the tree never wipes them
        || (doc == 'research'
          && request.resource.data.keys().hasOnly(['people', 'count', 'createdAt', 'by'])
          && request.resource.data.people is map && request.resource.data.count is int
          && optStr(request.resource.data, 'by', 80)));
      allow delete: if isAdmin();
    }

    // ---- Family tree photos: one small portrait per person ----
    match /treePhotos/{pid} {
      function validTreePhoto() {
        return pid.matches('[A-Za-z0-9_-]{1,40}')
          && request.resource.data.keys().hasOnly(['img', 'uid', 'by', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && str(request.resource.data.by, 1, 80)
          && isImage(request.resource.data.img, 90000);
      }
      allow read:   if isMember();
      allow create: if isMember() && validTreePhoto();
      allow update: if isMember() && validTreePhoto() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isMember() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
