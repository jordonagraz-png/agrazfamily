rules_version = '2';

// ============================================================================
//  Agraz Family — Firestore Security Rules
//
//  PUBLISH THESE in the Firebase console (Firestore Database → Rules → Publish)
//  or with the CLI:  firebase deploy --only firestore:rules
//  See README.md for the one-time setup (the invite code lives in config/invite).
//
//  These rules are the ONLY thing that keeps family data private. The website
//  is public code; nothing secret is in it.
//
//  Membership model
//  ----------------
//  • You are a family member if a document exists at users/{your uid}.
//  • That document can only be created after you've written joins/{your uid}
//    containing the correct invite code — and the code is checked HERE, on the
//    server, against config/invite (which no browser can read).
//  • To remove someone: delete their users/{uid} doc in the console (and
//    optionally disable their account under Authentication → Users).
//  • To change the invite code: edit the "code" field of config/invite.
//    Existing members are unaffected.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // A base64 image data URL (what the site produces), under `max` characters.
    function isImage(s, max) {
      return s is string && s.size() < max
        && s.matches('data:image/(png|jpe?g|gif|webp);base64,[A-Za-z0-9+/]+=*');
    }

    // Optional string field: absent, or a string no longer than `max`.
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // ---- Private settings (invite code). Edited only in the Firebase console. ----
    match /config/{doc} {
      allow read, write: if false;
    }

    // ---- Join requests: proves you know the invite code. Write-once, unreadable. ----
    match /joins/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['code', 'createdAt'])
                    && request.resource.data.code is string
                    && request.resource.data.code == get(/databases/$(database)/documents/config/invite).data.code;
      allow read, update, delete: if false;
    }

    // ---- Member profiles (the family directory) ----
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'email', 'uid', 'joinedDate', 'phone', 'birthday', 'address', 'bio', 'avatar'])
          && d.uid == uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && optStr(d, 'email', 254) && optStr(d, 'joinedDate', 40)
          && optStr(d, 'phone', 40) && optStr(d, 'birthday', 10)
          && optStr(d, 'address', 300) && optStr(d, 'bio', 280)
          && (!('avatar' in d) || d.avatar == '' || isImage(d.avatar, 150000));
      }
      // Members see the whole family; anyone signed in may check their own doc
      // (that's how the site knows whether to ask for the invite code).
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
                    && exists(/databases/$(database)/documents/joins/$(uid))
                    && validProfile(request.resource.data)
                    && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
                    && validProfile(request.resource.data)
                    && request.resource.data.get('email', '') == resource.data.get('email', '');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Shared photo album ----
    match /memories/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && isImage(request.resource.data.imageData, 950000)
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() < 2000;
      // Shared family album: any member may remove a photo. To limit this to the
      // uploader, use:  allow delete: if isMember() && resource.data.uid == request.auth.uid;
      allow delete: if isMember();
    }

    // ---- Family calendar ----
    match /events/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 200
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.description is string
                    && request.resource.data.description.size() < 5000
                    && optStr(request.resource.data, 'time', 5)
                    && optStr(request.resource.data, 'location', 200);
      allow delete: if isMember();
    }

    // ---- Updates feed ----
    match /updates/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 5000;
      allow delete: if isMember();
    }

    // ---- Family Vault: shared notes (emergency contacts, doctors, household info) ----
    match /vault/{id} {
      function validNote(d) {
        return d.keys().hasOnly(['title', 'body', 'category', 'uid', 'author', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.body is string && d.body.size() <= 8000
          && d.category in ['emergency', 'medical', 'household', 'documents', 'other'];
      }
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && validNote(request.resource.data);
      allow update: if isMember()
                    && validNote(request.resource.data)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isMember();
    }

    // ---- In Memory of Hector Agraz: private family photos ----
    match /memorial/{id} {
      allow read:   if isMember();
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && isImage(request.resource.data.imageData, 950000)
                    && request.resource.data.order is number;
      allow delete: if isMember();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
