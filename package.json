{
  "name": "agrazfamily",
  "private": true,
  "description": "agrazfamily.com — public site + private Family Hub (static, GitHub Pages + Firebase)",
  "type": "module",
  "scripts": {
    "serve": "node tests/serve.mjs",
    "test": "npm run test:tree && npm run test:rules && npm run test:ui",
    "test:tree": "node tests/tree.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-agraz \"node tests/rules.test.mjs\"",
    "test:ui": "node tests/ui.test.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "playwright": "1.56.1"
  }
}
